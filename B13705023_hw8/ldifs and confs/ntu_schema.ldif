  NAME 'studentEntryMethod'
  DESC 'Student entry method to NTU (e.g., examination, recommendation)'
  EQUALITY caseIgnoreMatch
  SUBSTR caseIgnoreSubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
  SINGLE-VALUE )
olcAttributeTypes: ( 1.3.6.1.4.1.99999.1.2
  NAME 'studentAdvisor'
  DESC 'Student academic advisor name'
  EQUALITY caseIgnoreMatch
  SUBSTR caseIgnoreSubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
  SINGLE-VALUE )
olcAttributeTypes: ( 1.3.6.1.4.1.99999.1.3
  NAME 'studentClub'
  DESC 'Student club membership (can have multiple values)'
  EQUALITY caseIgnoreMatch
